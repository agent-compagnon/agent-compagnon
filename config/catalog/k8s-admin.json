[
  {
    "name": "list_pods",
    "title": "List pods",
    "description": "Lists the pods of a namespace with their status and restarts.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "namespace": { "type": "string" },
        "label_selector": { "type": "string" }
      },
      "required": ["namespace"]
    },
    "annotations": { "readOnlyHint": true }
  },
  {
    "name": "get_pod_logs",
    "title": "Get pod logs",
    "description": "Returns the last lines of a container's logs.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "namespace": { "type": "string" },
        "pod": { "type": "string" },
        "container": { "type": "string" },
        "tail_lines": { "type": "integer", "minimum": 1, "maximum": 5000, "default": 200 }
      },
      "required": ["namespace", "pod"]
    },
    "annotations": { "readOnlyHint": true }
  },
  {
    "name": "scale_deployment",
    "title": "Scale deployment",
    "description": "Sets the number of replicas of a deployment.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "namespace": { "type": "string" },
        "deployment": { "type": "string" },
        "replicas": { "type": "integer", "minimum": 0 }
      },
      "required": ["namespace", "deployment", "replicas"]
    },
    "annotations": { "readOnlyHint": false, "destructiveHint": false, "idempotentHint": true }
  },
  {
    "name": "restart_deployment",
    "title": "Restart deployment",
    "description": "Triggers a rolling restart of a deployment.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "namespace": { "type": "string" },
        "deployment": { "type": "string" }
      },
      "required": ["namespace", "deployment"]
    },
    "annotations": { "readOnlyHint": false, "destructiveHint": false }
  },
  {
    "name": "delete_pod",
    "title": "Delete pod",
    "description": "Deletes a pod; its controller may recreate it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "namespace": { "type": "string" },
        "pod": { "type": "string" }
      },
      "required": ["namespace", "pod"]
    },
    "annotations": { "readOnlyHint": false, "destructiveHint": true }
  }
]
