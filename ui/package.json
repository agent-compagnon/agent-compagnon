{
  "name": "mcp-proxy-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode mock",
    "build": "vite build && node scripts/check-dist.mjs dist",
    "build:mock": "vite build --mode mock",
    "preview:mock": "vite preview --mode mock --outDir dist-mock --port 4173 --strictPort",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "e2e": "npm run build:mock && playwright test"
  },
  "dependencies": {
    "@lucide/vue": "1.70.0",
    "@tanstack/vue-table": "8.21.3",
    "@tauri-apps/api": "2.12.4",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0",
    "valibot": "1.5.0",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
